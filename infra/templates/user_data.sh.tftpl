#!/usr/bin/env bash
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive

PAL_USER=palworld
PAL_DIR=/home/palworld/PalServer
STEAMCMD=/usr/games/steamcmd

# SteamCMD ships as a 32-bit binary, so i386 must be enabled before apt can
# resolve its dependencies.
dpkg --add-architecture i386
apt-get update
apt-get install -y software-properties-common
add-apt-repository -y multiverse
apt-get update

echo steam steam/question select "I AGREE" | debconf-set-selections
echo steam steam/license note '' | debconf-set-selections
apt-get install -y steamcmd lib32gcc-s1 xdg-user-dirs jq unzip python3

# Noble dropped the awscli package from the archive, so the CLI comes from
# upstream. The secrets lookup below needs it.
curl -fsSL https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install
rm -rf /tmp/aws /tmp/awscliv2.zip

id -u $PAL_USER >/dev/null 2>&1 || useradd -m -s /bin/bash $PAL_USER

# Within the first minutes of boot app_update exits non-zero with "Missing
# configuration", and the identical command succeeds later, so it is retried.
for attempt in 1 2 3 4 5; do
  if sudo -u $PAL_USER $STEAMCMD \
      +force_install_dir "$PAL_DIR" \
      +login anonymous \
      +app_update ${steam_app_id} validate \
      +quit; then
    break
  fi
  echo "steamcmd attempt $attempt failed; retrying"
  sleep 30
done

# Stop before installing units around a server that is not there.
test -x "$PAL_DIR/PalServer.sh"

SECRETS=$(aws ssm get-parameter \
  --region ${aws_region} \
  --name "${secrets_parameter}" \
  --with-decryption \
  --query Parameter.Value \
  --output text)

CONFIG_DIR="$PAL_DIR/Pal/Saved/Config/LinuxServer"
CONFIG="$CONFIG_DIR/PalWorldSettings.ini"
mkdir -p "$CONFIG_DIR"
[ -f "$CONFIG" ] || cp "$PAL_DIR/DefaultPalWorldSettings.ini" "$CONFIG"

# The server writes its world and its engine log directly under Pal/Saved, so
# every directory on the way has to belong to it, not just the leaf. Left
# root-owned, the server still boots and answers packets, but no world is ever
# created and clients hang on "connecting" with nothing logged anywhere.
chown -R $PAL_USER:$PAL_USER "$PAL_DIR/Pal/Saved"

CONFIG="$CONFIG" \
SERVER_NAME='${server_name}' \
SERVER_DESC='${server_desc}' \
MAX_PLAYERS='${max_players}' \
GAME_PORT='${game_port}' \
REST_API_PORT='${rest_api_port}' \
ADMIN_PASSWORD="$(jq -r .admin_password <<<"$SECRETS")" \
python3 <<'PYTHON'
import os
import pathlib
import re

path = pathlib.Path(os.environ["CONFIG"])
text = path.read_text()

def quoted(value):
    return '"{}"'.format(value.replace('"', ""))

settings = {
    "ServerName": quoted(os.environ["SERVER_NAME"]),
    "ServerDescription": quoted(os.environ["SERVER_DESC"]),
    "AdminPassword": quoted(os.environ["ADMIN_PASSWORD"]),
    "ServerPlayerMaxNum": os.environ["MAX_PLAYERS"],
    "PublicPort": os.environ["GAME_PORT"],
    # ServerPassword stays at its empty default: the security group is the gate.
    #
    # The REST API answers the idle check over the loopback address. It binds
    # 0.0.0.0 and is not built to face the internet, so the security group must
    # never gain a TCP rule for its port. RCON is deprecated upstream and slated
    # for removal, and nothing here needs it.
    "RCONEnabled": "False",
    "RESTAPIEnabled": "True",
    # Pinned rather than left at the shipped default, because palworld-idle-stop
    # reads the same port from Terraform and a default that moved upstream would
    # make every check fail as if the server were empty.
    "RESTAPIPort": os.environ["REST_API_PORT"],
}

for key, value in settings.items():
    text, replaced = re.subn(
        r'(?<=[,(]){}=("[^"]*"|[^,)]*)'.format(key), "{}={}".format(key, value), text, count=1
    )
    # Pocketpair renames and drops keys between releases; a stale key must not
    # abort the whole provisioning run.
    if not replaced:
        print("skipped key absent from DefaultPalWorldSettings.ini:", key)

path.write_text(text)
PYTHON

cat >/etc/systemd/system/palworld.service <<UNIT
[Unit]
Description=Palworld dedicated server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=$PAL_USER
Group=$PAL_USER
WorkingDirectory=$PAL_DIR
# A client that has patched cannot join a server that has not, so every start
# updates first. Leading "-" because a Steam outage must not keep the server
# down: the old build still serves the clients that have not patched yet.
ExecStartPre=-$STEAMCMD +force_install_dir $PAL_DIR +login anonymous +app_update ${steam_app_id} validate +quit
# -EnableGameDataAPI exposes /v1/api/game-data, which the bot reads to answer
# questions about the world. It is a launch switch, not an ini key: the name is
# absent from DefaultPalWorldSettings.ini. The docs spell it
# "-enable-gamedata-api", but that string is absent from the v1.0.2 binary.
ExecStart=$PAL_DIR/PalServer.sh -port=${game_port} -players=${max_players} -useperfthreads -NoAsyncLoadingThread -UseMultithreadForDS -EnableGameDataAPI
# SIGINT lets the engine flush the world to disk; SIGTERM corrupts in-flight saves.
KillSignal=SIGINT
TimeoutStopSec=120
Restart=on-failure
RestartSec=10
LimitNOFILE=100000

[Install]
WantedBy=multi-user.target
UNIT

cat >/usr/local/bin/palworld-idle-stop <<'SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

MARK=/run/palworld-last-player
NOW=$(date +%s)

# /run is tmpfs, so the mark cannot outlive a stop: every boot starts a fresh
# window instead of inheriting the silence that ended the previous session.
[ -f $MARK ] || echo $NOW >$MARK

SECRETS=$(aws ssm get-parameter \
  --region ${aws_region} \
  --name "${secrets_parameter}" \
  --with-decryption \
  --query Parameter.Value \
  --output text)

# An unreachable API counts as empty. The window is far longer than a boot that
# includes a Steam update, so a server still starting is never cut off, while a
# server that has hung and stopped answering is exactly one worth stopping.
PLAYERS=$(curl -fsS --max-time 10 -u "admin:$(jq -r .admin_password <<<"$SECRETS")" \
  http://127.0.0.1:${rest_api_port}/v1/api/metrics | jq -r .currentplayernum) ||
  echo "no answer from the REST API; counting the server as empty"
case $PLAYERS in '' | *[!0-9]*) PLAYERS=0 ;; esac

if [ $PLAYERS -gt 0 ]; then
  echo $NOW >$MARK
  exit 0
fi

SINCE=$(cat $MARK)
IDLE=$((NOW - SINCE))
[ $IDLE -ge ${idle_stop_seconds} ] || exit 0

TOKEN=$(curl -fsS -X PUT http://169.254.169.254/latest/api/token \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
INSTANCE=$(curl -fsS -H "X-aws-ec2-metadata-token: $TOKEN" \
  http://169.254.169.254/latest/meta-data/instance-id)

echo "empty for $IDLE seconds; stopping $INSTANCE"
# Not "shutdown -h": disable_api_termination does not cover a shutdown started
# by the operating system, so an instance whose shutdown behaviour is terminate
# would destroy the volume holding the world. This call can only ever stop.
aws ec2 stop-instances --region ${aws_region} --instance-ids $INSTANCE
SCRIPT
chmod +x /usr/local/bin/palworld-idle-stop

cat >/etc/systemd/system/palworld-idle-stop.service <<UNIT
[Unit]
Description=Stop the instance once nobody is playing

[Service]
Type=oneshot
ExecStart=/usr/local/bin/palworld-idle-stop
UNIT

cat >/etc/systemd/system/palworld-idle-stop.timer <<UNIT
[Unit]
Description=Ask the server how many players are connected

[Timer]
OnBootSec=5min
OnUnitActiveSec=5min

[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
systemctl enable --now palworld.service palworld-idle-stop.timer
