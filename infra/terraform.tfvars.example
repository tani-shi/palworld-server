aws_region     = "ap-northeast-1"
server_version = "1.0"

server_name        = "My Palworld Server"
server_description = "Palworld 1.0"
max_players        = 16

# Public Key of the Discord application. Required. Not a secret: it only verifies
# that a request was signed by Discord.
discord_public_key = "..."

